{
  "name": "hengbeger",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org/",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org/",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "init-db": "node init-db.js",
    "launch": "node launcher.js",
    "launch:frontend": "node launcher.js frontend",
    "launch:backend": "node launcher.js backend",
    "setup-password": "node setup-mysql-password.js",
    "security-check": "node security-check.js",
    "generate-password": "node security-check.js --generate-password",
    "backup-database": "node scripts/backup-database.js",
    "migrate:columns": "node scripts/add-description-columns.js",
    "restore-storage": "node scripts/restore-storage-backup.js",
    "cleanup-storage-backups": "node scripts/cleanup-storage-backups.js",
    "crawl:mihoyo": "node scripts/crawl-mihoyo.js",
    "crawl:bwiki": "node scripts/crawl-bwiki.js",
    "crawl:gamekee": "node scripts/crawl-gamekee.js",
    "crawl:tools": "node scripts/crawl-tools.js",
    "crawl:nanoka": "node scripts/crawl-nanoka.js",
    "crawl:images": "node scripts/crawl-images.js",
    "sync": "node scripts/sync.js",
    "test:backend": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:backend:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:frontend": "vitest run src --environment jsdom",
    "test:frontend:coverage": "vitest run src --environment jsdom --coverage",
    "test": "npm run test:backend && npm run test:frontend",
    "test:coverage": "npm run test:backend:coverage && npm run test:frontend:coverage",
    "cloud:secrets": "node deploy/scripts/gen-secrets.mjs",
    "cloud:cert": "node deploy/scripts/make-cert.mjs",
    "cloud:preview:up": "docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.preview.yml up -d --build",
    "cloud:preview:down": "docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.preview.yml down",
    "cloud:preview:logs": "docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.preview.yml logs -f --tail=100",
    "cloud:preview:verify": "node deploy/scripts/verify-preview.mjs",
    "cloud:export": "node scripts/cloud/export-data.mjs",
    "cloud:export:count": "node scripts/cloud/export-data.mjs --count-only",
    "cloud:export:verify": "node scripts/cloud/export-data.mjs --verify",
    "cloud:images": "node scripts/cloud/export-images.mjs",
    "cloud:images:verify": "node scripts/cloud/export-images.mjs --verify",
    "cloud:import": "node scripts/cloud/import-data.mjs",
    "cloud:import:check": "node scripts/cloud/import-data.mjs --check",
    "cloud:preview:import": "docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.preview.yml exec -T app node scripts/cloud/import-data.mjs --dir /import",
    "cloud:preview:import:check": "docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.preview.yml exec -T app node scripts/cloud/import-data.mjs --dir /import --check",
    "cloud:push": "node scripts/cloud/push-data.mjs",
    "cloud:push:check": "node scripts/cloud/push-data.mjs --check",
    "cloud:test": "node --test scripts/cloud/test/tar.test.mjs scripts/cloud/test/push-data.test.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:dist": "npm --prefix desktop run dist",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:prebuild": "npm --prefix mobile run prebuild",
    "mobile:patch": "npm --prefix mobile run patch:android",
    "mobile:test": "npm --prefix mobile run test",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:pins": "node mobile/scripts/android-pins.mjs --cert deploy/ssl/server.crt --dir mobile/native",
    "verify:api": "node scripts/open-index-api-smoke.mjs",
    "verify:shots": "node scripts/open-index-shots.mjs",
    "demo:data": "node scripts/build-demo-data.mjs",
    "open-index:css": "node scripts/build-open-index-css.mjs"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "compression": "^1.7.4",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "dotenv-safe": "^8.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.0.0",
    "js-yaml": "^5.4.3",
    "katex": "^0.19.0",
    "mysql2": "^3.14.3",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jsdom": "^27.2.0",
    "sharp": "^0.35.5",
    "supertest": "^6.3.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/server/__tests__/**/*.js"
    ],
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "statements": 25,
        "branches": 15,
        "functions": 25,
        "lines": 25
      }
    }
  }
}
