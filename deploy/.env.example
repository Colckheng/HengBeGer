# ============================================================================
# HengBerGer 云端配置模板
#
#   cp deploy/.env.example deploy/.env   （或者直接 npm run cloud:secrets 自动生成）
#
# 这个文件是 docker compose 的变量来源：compose 会自动读取
# 「第一个 -f 指定的 compose 文件所在目录」下的 .env，也就是 deploy/.env。
# 容器实际拿到的变量名映射见 deploy/docker-compose.yml。
# ============================================================================

# ---- 部署位置 ----
# 云端：/srv/hengbeger/data
# 本机预演：留空即 ./data（展开为 deploy/data，已加进 .gitignore）
DATA_ROOT=./data

# 云端公网入口端口。大陆不备案 => 80/443 用不了，走高位端口。
HTTPS_PORT=8443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=hengbeger
DB_USER=hengbeger
DB_PASSWORD=change_me_app_password
# 2 核 2G 给 256M；4G 以上可以给 1G
MYSQL_BUFFER_POOL=256M

# ---- Node 应用 ----
ADMIN_PASSWORD=change_me_admin_password
AUTH_SECRET=change_me_auth_secret
LOG_LEVEL=info
SECURITY_SILENCE=false
# Nginx 恰好一层，必须是 1；写错会让全站限流塌成一个共享桶
TRUST_PROXY_HOPS=1
# 网页与 App 都是同源 / 无 Origin 请求，默认留空
CORS_ORIGINS=

# ---- 图片（阶段 2/4）----
# file = 图片由 Nginx 从 /srv/images 直出（云端唯一正确取值）
# db   = 图片存 MySQL，走应用出图接口（只有本机 npm run server 才用）
IMAGE_MODE=file

# 镜像标签（将来回滚用得上：APP_TAG=2026-10-14）
APP_TAG=latest

# ---- 预演覆盖层专用（只有叠加 docker-compose.preview.yml 时才生效）----
# 预演的 MySQL 数据目录必须与云端分开，否则两个 mysqld 会抢同一个目录
PREVIEW_DATA_ROOT=./data-preview
PREVIEW_HTTPS_PORT=8444
PREVIEW_MYSQL_PORT=3307

# ---- 时区 ----
TZ=Asia/Shanghai
