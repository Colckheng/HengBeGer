DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hengbeger

PORT=3001
NODE_ENV=development
INIT_DB=false
DB_AUTO_ALTER=false

ADMIN_PASSWORD=change_this_admin_password
AUTH_SECRET=change_this_auth_secret

LOG_LEVEL=info
SECURITY_SILENCE=false

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api

# Set to the number of reverse-proxy hops (single Nginx = 1) when deployed behind a proxy;
# leave empty when the server is directly reachable. Wrong value collapses all rate limits into one shared bucket.
TRUST_PROXY_HOPS=

# Usage:
# 1. Copy this file to `.env`
# 2. Fill in the MySQL credentials and admin auth secrets
# 3. Set CORS_ORIGINS to the comma-separated frontend origins you actually deploy
# 4. Only turn on DB_AUTO_ALTER in local development when you intentionally want Sequelize to mutate the schema
# 5. LOG_LEVEL is optional (debug/info/warn/error); SECURITY_SILENCE=true only for local dev
# 6. Set NODE_ENV=production when deploying
# 7. Set TRUST_PROXY_HOPS only when running behind a reverse proxy (see docs/06-deployment.md)
