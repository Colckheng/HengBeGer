DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=HengBeGer

PORT=3001
NODE_ENV=development
INIT_DB=false
DB_AUTO_ALTER=false

ADMIN_PASSWORD=change_this_admin_password
AUTH_SECRET=change_this_auth_secret
ADMIN_API_TOKEN=

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api

# Usage:
# 1. Copy this file to `.env`
# 2. Fill in the MySQL credentials and admin auth secrets
# 3. Set CORS_ORIGINS to the comma-separated frontend origins you actually deploy
# 4. Only turn on DB_AUTO_ALTER in local development when you intentionally want Sequelize to mutate the schema
